{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/randomcarol/lake-room-digital-world/world-model/schema.json",
  "title": "Lake Room simulation scenario",
  "type": "object",
  "required": ["schema", "version", "season", "timeOfDay", "locations", "actors"],
  "properties": {
    "schema": {"const": "lake-room-simulation"},
    "version": {"const": 1},
    "season": {"enum": ["spring", "summer", "autumn", "winter"]},
    "timeOfDay": {"enum": ["morning", "day", "dusk", "night"]},
    "locations": {"type": "array", "minItems": 1, "maxItems": 32, "items": {"type": "object", "required": ["id", "label", "neighbors"], "properties": {"id": {"type": "string", "minLength": 1, "maxLength": 64}, "label": {"type": "string", "minLength": 1, "maxLength": 120}, "neighbors": {"type": "array", "items": {"type": "string"}}}, "additionalProperties": false}},
    "actors": {"type": "array", "minItems": 1, "maxItems": 32, "items": {"type": "object", "required": ["id", "displayName", "kind", "species", "speechMode", "locationId", "needs", "traits"], "properties": {"id": {"type": "string", "minLength": 1, "maxLength": 64}, "displayName": {"type": "string", "minLength": 1, "maxLength": 80}, "kind": {"enum": ["person", "animal"]}, "species": {"type": "string", "minLength": 1, "maxLength": 80}, "speechMode": {"enum": ["human", "nonverbal"]}, "locationId": {"type": "string"}, "needs": {"$ref": "#/$defs/needs"}, "traits": {"$ref": "#/$defs/traits"}}, "allOf": [{"if": {"properties": {"kind": {"const": "animal"}}, "required": ["kind"]}, "then": {"properties": {"speechMode": {"const": "nonverbal"}}}}], "additionalProperties": false}}
  },
  "$defs": {
    "unit": {"type": "number", "minimum": 0, "maximum": 1},
    "needs": {"type": "object", "required": ["energy", "social", "curiosity"], "properties": {"energy": {"$ref": "#/$defs/unit"}, "social": {"$ref": "#/$defs/unit"}, "curiosity": {"$ref": "#/$defs/unit"}}, "additionalProperties": false},
    "traits": {"type": "object", "required": ["sociability", "curiosity"], "properties": {"sociability": {"$ref": "#/$defs/unit"}, "curiosity": {"$ref": "#/$defs/unit"}}, "additionalProperties": false}
  },
  "additionalProperties": false
}
